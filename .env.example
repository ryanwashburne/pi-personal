# Sprite HTTP
PORT=8080
# Loopback-only port Pi uses to start Sprite Chromium. Not on the public Sprite URL.
# INTERNAL_PORT=8081

# Unguessable path segment. Sendblue posts to /webhooks/sendblue/$WEBHOOK_PATH_SECRET
WEBHOOK_PATH_SECRET=replace-with-a-long-random-string

# Unguessable settings page at /settings/$DASHBOARD_SECRET. Leave empty to disable it.
DASHBOARD_SECRET=replace-with-a-long-random-string

# Unguessable home-daemon ping at /heartbeat/$HEARTBEAT_SECRET. Leave empty to disable it.
# The Mac or Raspberry Pi runs ./scripts/install-home.sh and curls this on a timer.
HEARTBEAT_SECRET=replace-with-a-long-random-string
# HEARTBEAT_INTERVAL_SECONDS=7200
# Home-daemon Tailscale HTTP port for routine create/list/delete (default 8787).
# HOME_DAEMON_PORT=8787

# Public Sprite origin. provision.sh writes this from `sprite info` so Pi can text the live view URL.
# SPRITE_URL=https://xxxx.sprites.app

# Sendblue (iMessage). Dashboard or `sendblue show-keys`.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_KEY_SECRET=
SENDBLUE_FROM_NUMBER=+15551234567
SENDBLUE_WEBHOOK_SECRET=replace-with-a-long-random-string

# Only this number can talk to the agent. E.164.
ALLOWED_PHONE=+15557654321

# Pi
PI_CLI=pi
AGENT_CWD=/home/sprite/agent
SESSION_DIR=/home/sprite/agent/sessions
# Optional. Project file Pi reads with --approve. Defaults to $AGENT_CWD/.pi/mcp.json
# Gitignored; the gateway writes host bun/Playwright paths here. Do not commit it.
# MCP_CONFIG_PATH=/home/sprite/agent/.pi/mcp.json
# Optional. User-level file Pi always reads. Defaults to ~/.pi/agent/mcp.json
# MCP_USER_CONFIG_PATH=/home/sprite/.pi/agent/mcp.json
AGENT_TIMEOUT_MS=600000
# Models go through OpenRouter, not a direct Anthropic key.
PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-haiku-5.5

# Optional. Sprite Chrome egress via a Tailscale exit node (MacBook or rpi).
# Auth key is for the Sprite. Exit node is the home box hostname (or 100.x).
# Home box (Mac or Raspberry Pi): ./scripts/install-home.sh
TAILSCALE_AUTHKEY=
TAILSCALE_EXIT_NODE=
# TAILSCALE_SOCKS_PORT=1055

# Model key. Pi also reads keys from /home/sprite/.pi after `pi auth login openrouter`.
OPENROUTER_API_KEY=
# Unused unless you switch providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional. Gmail, Calendar, Drive, and search MCP (Sprite → Google REST).
# Create a Web application OAuth client and add the redirect URI shown on
# the settings page (.../google/callback). Personal Gmail works.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
